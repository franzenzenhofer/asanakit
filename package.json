{
  "name": "@franzenzenhofer/asanakit",
  "version": "0.5.0",
  "description": "Programmatic stick-figure and body-posture visualization engine for yoga and surf. Declarative 3D pose format, deterministic any-angle SVG/PNG, interactive three.js viewer, GLB export, Rapier physics settling. CLI-first, AI-driveable.",
  "keywords": [
    "yoga",
    "surf",
    "asana",
    "stick-figure",
    "anatomy",
    "infographic",
    "svg",
    "png",
    "pose",
    "skeleton",
    "kinematics",
    "cli",
    "typescript",
    "3d",
    "three.js",
    "gltf",
    "glb",
    "physics",
    "rapier",
    "camera"
  ],
  "license": "MIT",
  "author": "Franz Enzenhofer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franzenzenhofer/asanakit.git"
  },
  "homepage": "https://github.com/franzenzenhofer/asanakit#readme",
  "bugs": {
    "url": "https://github.com/franzenzenhofer/asanakit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "asanakit": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./physics": {
      "types": "./dist/physics/index.d.ts",
      "default": "./dist/physics/index.js"
    }
  },
  "files": [
    "dist",
    "poses",
    "docs/AUTHORING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js && tsx scripts/build-viewer.ts",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit && tsc -p viewer-src/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "gallery": "tsx scripts/gallery.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^14.0.1",
    "culori": "^4.0.2",
    "d3-path": "^3.1.0",
    "d3-shape": "^3.2.0",
    "gl-matrix": "^3.4.4",
    "svgo": "^4.0.2",
    "three": "0.185.1",
    "xmlbuilder2": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/d3-path": "^3.1.1",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24.9.2",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.38.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@resvg/resvg-js@2.6.2": true
  }
}
